# Contact details (shown on the site). Replace the placeholders with the real values.
NEXT_PUBLIC_SITE_URL=https://www.example.co.za
NEXT_PUBLIC_PHONE_DISPLAY="011 000 0000"
NEXT_PUBLIC_PHONE_TEL=+27110000000
NEXT_PUBLIC_WHATSAPP=27110000000
NEXT_PUBLIC_EMAIL=info@example.co.za

# Quote form email delivery (Resend). Without a key the form logs to the server console only.
RESEND_API_KEY=
QUOTE_TO_EMAIL=info@example.co.za
QUOTE_FROM_EMAIL="Pimhra Projects Website <quotes@example.co.za>"

# Cloudflare Turnstile (spam protection without a puzzle). Optional but recommended.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
